{
    "private": true,
    "workspaces": [
        "projects/*"
    ],
    "scripts": {
        "build": "cargo build --release",
        "fmt": "cargo fmt --all",
        "p": "git push && git push --tags --prune",
        "reset": "git reset Head~ --soft",
        "u": "cargo upgrade --workspace",
        "dev:h5": "pnpm --filter balancer-h5 dev",
        "build:ts": "pnpm --filter balancer-ts build",
        "test:ts": "pnpm --filter balancer-ts test"
    },
    "packageManager": "pnpm@10.11.0",
    "devDependencies": {
        "@iconify-json/carbon": "^1.1.0",
        "@iconify-json/mdi": "^1.1.0",
        "@types/node": "^20.0.0",
        "@unocss/preset-icons": "^0.58.0",
        "@unocss/preset-uno": "^0.58.0",
        "@vitejs/plugin-vue": "^5.0.0",
        "@vitest/coverage-v8": "^1.0.0",
        "@vue/tsconfig": "^0.5.0",
        "typescript": "^5.8.3",
        "unocss": "^0.58.0",
        "vite": "^5.0.0",
        "vitest": "^1.0.0",
        "vue-tsc": "^1.8.0"
    }
}
